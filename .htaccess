# ===== PLANTILLA .htaccess · estándar web profesional Lokio (reemplazar DOMINIO.cl) =====
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

# --- HTTPS + dominio canónico (sin www) ---
# ANTES de activar: verificar `curl -sI https://dominio-por-confirmar.cl` y `curl -sI https://www.DOMINIO.cl` (ambos deben responder 200 con certificado válido).
# Si el canónico es con www: cambiar a ^DOMINIO-POR-CONFIRMAR\.cl$ -> https://www.DOMINIO.cl
<IfModule mod_rewrite.c>
RewriteEngine On
# no tocar la validación de certificados (AutoSSL / Let's Encrypt)
RewriteRule ^\.well-known/ - [L]
# (activar redirect HTTPS al tener dominio y SSL)
# RewriteCond %{HTTPS} !=on
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteRule ^ https://dominio-por-confirmar.cl%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# --- archivos privados ---
<FilesMatch "(?i)\.(sqlite|sqlite3|db|bak|log|md|ini|lock|sh|py)$">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
Order allow,deny
Deny from all
</IfModule>
</FilesMatch>

# --- cabeceras de seguridad ---
<IfModule mod_headers.c>
# ACTIVAR SOLO CON CERTIFICADO VÁLIDO: Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
Header always set Cross-Origin-Opener-Policy "same-origin"
# Si algo deja de funcionar, cambiar "Content-Security-Policy" por "Content-Security-Policy-Report-Only" y revisar la consola.
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self'; frame-src 'self' https://www.google.com https://maps.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; manifest-src 'self'; upgrade-insecure-requests"
# Para carpetas privadas (admin/, api/) crear un .htaccess dentro con:
#   Header always set X-Robots-Tag "noindex, nofollow"
#   Header always set Cache-Control "no-store"
<FilesMatch "\.(html|json|webmanifest)$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(css|js|webp|png|jpe?g|svg|ico|woff2?)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>

# --- compresión ---
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_brotli.c>
AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# --- caché ---
<IfModule mod_mime.c>
AddType application/manifest+json .webmanifest
AddType image/webp .webp
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 hour"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType application/json "access plus 0 seconds"
ExpiresByType text/css "access plus 30 days"
ExpiresByType application/javascript "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType image/x-icon "access plus 30 days"
</IfModule>
